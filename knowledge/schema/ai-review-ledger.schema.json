{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cissp-buddy.local/schema/ai-review-ledger.schema.json",
  "title": "ai-review-ledger",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "reviewType": {
      "const": "AI only; no human expert review"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "contentSha256": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "source-checked",
              "ai-reviewed",
              "needs-correction"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "pointers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "textSha256": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "category": {
                  "type": "string",
                  "minLength": 1
                },
                "adjudicatedWording": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "object",
                        "minProperties": 1
                      },
                      "inspected": {
                        "type": "boolean"
                      },
                      "independenceGroup": {
                        "type": "string",
                        "minLength": 1
                      },
                      "independenceRationale": {
                        "type": "string",
                        "minLength": 1
                      },
                      "supportExplanation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reviewerId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "report": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "sourceId",
                      "locator",
                      "inspected",
                      "independenceGroup",
                      "independenceRationale",
                      "supportExplanation",
                      "reviewerId",
                      "report"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "confidence": {
                  "enum": [
                    "high",
                    "medium",
                    "low",
                    "unreviewed"
                  ]
                },
                "volatility": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "unassessed"
                  ]
                },
                "reviewBy": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "pending",
                    "corroborated",
                    "needs-correction",
                    "pedagogical"
                  ]
                },
                "scopeAndConflicts": {
                  "type": "string",
                  "minLength": 1
                },
                "adjudicationIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "pointers",
                "textSha256",
                "category",
                "adjudicatedWording",
                "evidence",
                "confidence",
                "volatility",
                "reviewBy",
                "status",
                "scopeAndConflicts",
                "adjudicationIds"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "enum": [
                    "primary",
                    "corroborating",
                    "adversarial",
                    "visual-pedagogy",
                    "memory-map"
                  ]
                },
                "reviewerId": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "enum": [
                    "gpt-5.6-luna",
                    "gpt-5.6-terra",
                    "gpt-5.6-sol",
                    "root"
                  ]
                },
                "report": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "pending",
                    "completed",
                    "changes-required"
                  ]
                },
                "reviewedContentSha256": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "role",
                "reviewerId",
                "model",
                "report",
                "status",
                "reviewedContentSha256"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "completed"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reviewedContentSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 0
          },
          "scopeChecked": {
            "type": "boolean"
          },
          "examplesChecked": {
            "type": "boolean"
          },
          "visualLearningChecked": {
            "type": "boolean"
          },
          "memoryPlacementChecked": {
            "type": "boolean"
          },
          "conflictsAdjudicated": {
            "type": "boolean"
          },
          "openIssues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "unitId",
          "contentSha256",
          "status",
          "claims",
          "reviews",
          "scopeChecked",
          "examplesChecked",
          "visualLearningChecked",
          "memoryPlacementChecked",
          "conflictsAdjudicated",
          "openIssues"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "reviewType",
    "units"
  ],
  "additionalProperties": false
}
