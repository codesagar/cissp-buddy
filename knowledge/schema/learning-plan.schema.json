{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cissp-buddy.local/schema/learning-plan.schema.json",
  "title": "CISSP Buddy domain learning plan",
  "type": "object",
  "required": ["schemaVersion", "id", "domainId", "title", "paths"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^d[1-8]-learning-plan$" },
    "domainId": { "type": "integer", "minimum": 1, "maximum": 8 },
    "title": { "type": "string", "minLength": 8 },
    "principle": { "type": "string" },
    "paths": {
      "type": "object",
      "required": ["fast", "standard", "reinforcement"],
      "properties": {
        "fast": { "$ref": "#/$defs/sequencedPath" },
        "standard": { "$ref": "#/$defs/sequencedPath" },
        "reinforcement": { "$ref": "#/$defs/reinforcementPath" }
      }
    },
    "completionEvidence": {},
    "review": { "type": "object" }
  },
  "$defs": {
    "sequencedPath": {
      "type": "object",
      "required": ["sequence", "method"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1 },
        "targetMinutes": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "method": { "type": "string", "minLength": 20 }
      },
      "anyOf": [{ "required": ["minutes"] }, { "required": ["targetMinutes"] }]
    },
    "reinforcementPath": {
      "type": "object",
      "properties": {
        "minutes": { "type": "integer", "minimum": 1 },
        "cadence": { "type": "string" },
        "sequence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sessions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "method": { "type": "string" }
      },
      "anyOf": [{ "required": ["sequence", "method"] }, { "required": ["sessions", "cadence"] }]
    }
  }
}
