{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cissp-buddy.local/schema/visual-learning-contracts.schema.json",
  "title": "visual-learning-contracts",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "teachingQuestion": {
            "type": "string",
            "minLength": 1
          },
          "misconception": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "string",
            "minLength": 1
          },
          "formRationale": {
            "type": "string",
            "minLength": 1
          },
          "focalInsight": {
            "type": "string",
            "minLength": 1
          },
          "conceptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 0
          },
          "intentionalOmissions": {
            "type": "string",
            "minLength": 1
          },
          "retrievalPrompt": {
            "type": "string",
            "minLength": 1
          },
          "textFallback": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "mapNodeId": {
            "type": "string",
            "minLength": 1
          },
          "visualIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "unitId",
          "teachingQuestion",
          "misconception",
          "form",
          "formRationale",
          "focalInsight",
          "conceptIds",
          "relationships",
          "intentionalOmissions",
          "retrievalPrompt",
          "textFallback",
          "sourceRefIds",
          "mapNodeId",
          "visualIds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "contracts"
  ],
  "additionalProperties": false
}
