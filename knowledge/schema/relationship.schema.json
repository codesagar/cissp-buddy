{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cissp-buddy.local/schema/relationship.schema.json",
  "title": "CISSP Buddy cross-domain objective relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "fromObjectiveId", "toObjectiveId", "kind", "directionality", "learnerRationale", "sourceSupport"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^rel-d[1-8]-o[0-9]{2}-to-d[1-8]-o[0-9]{2}-[a-z0-9-]+$" },
    "fromObjectiveId": { "type": "string", "pattern": "^d[1-8]-o[0-9]{2}$" },
    "toObjectiveId": { "type": "string", "pattern": "^d[1-8]-o[0-9]{2}$" },
    "kind": { "enum": ["informs", "constrains", "implements", "depends-on", "provides-evidence-for", "validates", "operationalizes", "recovers", "governs"] },
    "directionality": { "enum": ["directed", "bidirectional"] },
    "learnerRationale": { "type": "string", "minLength": 30 },
    "sourceSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "note"],
      "properties": {
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "note": { "type": "string", "minLength": 30 }
      }
    }
  }
}
