{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cissp-buddy.local/schema/domain-map.schema.json",
  "title": "domain-map",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "domainId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "rootNodeId": {
      "type": "string",
      "minLength": 1
    },
    "parentMap": {
      "type": "string",
      "minLength": 1
    },
    "nodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "edgeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "externalEdgeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "objectiveIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unitIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "primaryStructure": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "domainId",
    "rootNodeId",
    "parentMap",
    "nodeIds",
    "edgeIds",
    "externalEdgeIds",
    "objectiveIds",
    "unitIds",
    "purpose",
    "primaryStructure"
  ],
  "additionalProperties": false
}
