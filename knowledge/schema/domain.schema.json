{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cissp-buddy.local/schema/domain.schema.json",
  "title": "CISSP Buddy canonical domain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "number", "name", "officialWeight", "outlineSourceId", "outlineEffectiveDate", "summary", "managerMindset", "objectiveUnitMap", "learningPlanId", "visualIds", "crossDomainConnections", "review"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^d[1-8]$" },
    "number": { "type": "integer", "minimum": 1, "maximum": 8 },
    "name": { "type": "string", "minLength": 3 },
    "officialWeight": { "type": "integer", "minimum": 1, "maximum": 100 },
    "outlineSourceId": { "type": "string" },
    "outlineEffectiveDate": { "type": "string", "format": "date" },
    "summary": { "type": "string", "minLength": 40 },
    "managerMindset": { "type": "string", "minLength": 20 },
    "objectiveUnitMap": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["objectiveId", "objectiveRecordId", "unitIds"],
        "properties": {
          "objectiveId": { "type": "string", "pattern": "^[1-8]\\.[0-9]{1,2}$" },
          "objectiveRecordId": { "type": "string", "pattern": "^d[1-8]-o[0-9]{2}$" },
          "unitIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "learningPlanId": { "type": "string" },
    "visualIds": { "type": "array", "items": { "type": "string" } },
    "crossDomainConnections": { "type": "array", "items": { "type": "object" } },
    "legacyConceptIds": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "object" },
    "sourceQualityNotes": { "type": "array", "items": { "type": "string" } },
    "review": { "type": "object", "required": ["status", "reviewers", "lastReviewedAt"] }
  }
}
