{
  "name": "cissp-buddy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/static-server.mjs --root=dist",
    "lint": "oxlint app lib src components/study-app.tsx components/concept-visual.tsx components/recursive-map.tsx components/learning-blocks.tsx components/course-app.tsx components/course-figure.tsx components/course-labs.tsx components/course-relationship-map.tsx components/course-recovery-timeline.tsx components/course-evidence-labs.tsx components/course-reasoning-visuals.tsx",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "content:validate": "node --experimental-strip-types scripts/validate-content.mjs && npm run course:check",
    "course:render-check": "node --import ./scripts/qa-tsx-loader.mjs ./scripts/verify-course-renders.mjs",
    "course:generate": "node --experimental-strip-types scripts/generate-course.mjs",
    "course:check": "node --experimental-strip-types scripts/generate-course.mjs --check",
    "course:coverage": "node scripts/generate-course-coverage.mjs",
    "qa:final": "node --experimental-strip-types scripts/run-final-validation.mjs",
    "prebuild": "npm run content:validate",
    "preview": "vite preview",
    "course:static-check": "node --experimental-strip-types scripts/verify-static-output.mjs",
    "test:cloud": "node scripts/run-cloud-tests.mjs",
    "firebase:owner": "node --experimental-strip-types scripts/firebase-owner-config.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "firebase": "13.2.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "firebase-tools": "15.34.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
